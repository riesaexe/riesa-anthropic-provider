{
  "manifest_version": 2,
  "id": "riesa.anthropic-provider",
  "version": "0.1.2",
  "name": "Anthropic 兼容模型 Provider",
  "description": "为 MaiBot 增加 Anthropic Messages 兼容客户端，复用 Host Provider 配置，并支持 DeepSeek 原生联网搜索。",
  "author": {
    "name": "RiESA",
    "url": "https://github.com/RiESA"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/riesaexe/riesa-anthropic-provider",
    "documentation": "https://github.com/riesaexe/riesa-anthropic-provider/blob/main/README.md"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "anthropic",
      "version_spec": ">=0.104.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "maibot-plugin-sdk",
      "version_spec": ">=2.8.1,<3.0.0"
    }
  ],
  "llm_providers": [
    {
      "client_type": "anthropic_messages",
      "name": "Anthropic Messages Provider",
      "description": "通过 Anthropic Messages API 调用 DeepSeek 或其他兼容服务，支持原生联网搜索。",
      "version": "0.1.2"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
